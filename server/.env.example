# ==============================================================================
# Mailpilot Server Configuration Template
# Copy this file to `server/.env` and configure your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime & Network Binding
# ------------------------------------------------------------------------------

# Purpose: Application runtime environment ('development', 'production', or 'test')
# Default: development
# Example: NODE_ENV=development
# Required: Optional
NODE_ENV=development

# Purpose: Network interface host to bind the HTTP server to (127.0.0.1 for local security)
# Default: 127.0.0.1
# Example: HOST=127.0.0.1
# Required: Optional
HOST=127.0.0.1

# Purpose: Port number the backend server listens on
# Default: 3000
# Example: PORT=3000
# Required: Optional
PORT=3000

# Purpose: Frontend client URL allowed for CORS requests and post-OAuth redirect target
# Default: http://localhost:5173
# Example: CLIENT_URL=http://localhost:5173
# Required: Optional
CLIENT_URL=http://localhost:5173

# Purpose: Server base URL used to construct the OAuth callback URL (<BASE_URL>/auth/google/callback)
# Default: http://localhost:3000
# Example: BASE_URL=http://localhost:3000
# Required: Optional
BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------

# Purpose: MongoDB database connection string
# Default: None
# Example: MONGO_URI=mongodb://127.0.0.1:27017/mailpilot
# Required: Required
MONGO_URI=mongodb://127.0.0.1:27017/mailpilot

# ------------------------------------------------------------------------------
# Google Cloud OAuth 2.0 Credentials
# ------------------------------------------------------------------------------

# Purpose: Google OAuth 2.0 Web Client ID from Google Cloud Console
# Default: None
# Example: GOOGLE_CLIENT_ID=123456789-abcdef.apps.googleusercontent.com
# Required: Required
GOOGLE_CLIENT_ID=your_google_client_id_here

# Purpose: Google OAuth 2.0 Web Client Secret from Google Cloud Console
# Default: None
# Example: GOOGLE_CLIENT_SECRET=GOCSPX-abcdef123456
# Required: Required
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ------------------------------------------------------------------------------
# Security & Session Secrets
# ------------------------------------------------------------------------------

# Purpose: Cryptographic secret used to sign and verify user session JWTs (32-byte hex)
# Default: Auto-generated on first startup if missing
# Example: JWT_SECRET=4f9c2d1e8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d
# Required: Optional (auto-generated if omitted)
JWT_SECRET=

# Purpose: 32-byte hex encryption key used to encrypt Google OAuth refresh tokens at rest (AES-256-GCM)
# Default: Auto-generated and persisted to server/.env on first startup if missing
# Example: TOKEN_ENCRYPTION_KEY=1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b
# Required: Optional (auto-generated if omitted)
TOKEN_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# Local AI Engine (Ollama)
# ------------------------------------------------------------------------------

# Purpose: Base URL of the local Ollama API server
# Default: http://127.0.0.1:11434
# Example: OLLAMA_BASE_URL=http://127.0.0.1:11434
# Required: Optional
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Purpose: Ollama LLM model name used for email drafting, classification, and AI assist
# Default: qwen2.5:7b
# Example: OLLAMA_LLM_MODEL=qwen2.5:7b
# Required: Optional
OLLAMA_LLM_MODEL=qwen2.5:7b

# Purpose: Ollama embedding model name used to vectorize knowledge documents
# Default: embeddinggemma-2:270m
# Example: OLLAMA_EMBEDDING_MODEL=embeddinggemma-2:270m
# Required: Optional
OLLAMA_EMBEDDING_MODEL=embeddinggemma-2:270m

# Purpose: Context window size (in tokens) configured for Ollama LLM inferences
# Default: 4096
# Example: OLLAMA_NUM_CTX=4096
# Required: Optional
OLLAMA_NUM_CTX=4096

# ------------------------------------------------------------------------------
# Vector Knowledge Base (LanceDB)
# ------------------------------------------------------------------------------

# Purpose: Local filesystem directory path for storing the LanceDB vector database
# Default: ./data/lancedb
# Example: LANCEDB_PATH=./data/lancedb
# Required: Optional
LANCEDB_PATH=./data/lancedb

# Purpose: Maximum L2 distance threshold for vector knowledge document search matches
# Default: 0.5
# Example: RAG_MAX_DISTANCE=0.5
# Required: Optional
RAG_MAX_DISTANCE=0.5

# ------------------------------------------------------------------------------
# Automation, Sync & Safety Guardrails
# ------------------------------------------------------------------------------

# Purpose: Master switch to enable or disable automated background Gmail polling
# Default: true
# Example: SYNC_ENABLED=true
# Required: Optional
SYNC_ENABLED=true

# Purpose: Maximum number of automated replies per user per UTC day
# Default: 50
# Example: DAILY_REPLY_CAP=50
# Required: Optional
DAILY_REPLY_CAP=50

# Purpose: Window in days to group follow-up emails by sender into existing threads
# Default: 14
# Example: GROUP_WINDOW_DAYS=14
# Required: Optional
GROUP_WINDOW_DAYS=14

# Purpose: Lookback window in hours when performing initial mailbox synchronization
# Default: 48
# Example: CATCHUP_HOURS=48
# Required: Optional
CATCHUP_HOURS=48

# Purpose: Maximum number of unread email messages fetched and processed in a single poll cycle
# Default: 25
# Example: MAX_PER_RUN=25
# Required: Optional
MAX_PER_RUN=25

# Purpose: Sets Node.js DNS resolution order to prefer IPv4 over IPv6 to avoid ECONNRESET on Google APIs
# Default: true
# Example: PREFER_IPV4=true
# Required: Optional
PREFER_IPV4=true
