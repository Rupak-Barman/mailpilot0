# ==============================================================================
# Mailpilot Server Configuration Template
# Copy this file to `server/.env` and fill in your Google and MongoDB credentials.
# ==============================================================================

# Network & Host Binding
# HOST defaults to 127.0.0.1 for local security. Use 0.0.0.0 for Docker containers only.
HOST=127.0.0.1
PORT=3000

# Client (Frontend) URL for CORS and OAuth redirects
CLIENT_URL=http://localhost:5173

# Server Base URL (used to derive OAuth callback URL: <BASE_URL>/auth/google/callback)
BASE_URL=http://localhost:3000

# Database
# Required: MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/mailpilot

# Google Cloud OAuth 2.0 Credentials (REQUIRED)
# 1. Create a project in Google Cloud Console: https://console.cloud.google.com/
# 2. Enable Gmail API: https://console.cloud.google.com/apis/library/gmail.googleapis.com
# 3. Configure OAuth Consent Screen ("In production" recommended for personal use)
# 4. Create OAuth 2.0 Client ID (Web Application)
# 5. Add Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Security Secrets (OPTIONAL - auto-generated on first startup if missing)
# JWT_SECRET: signs authentication tokens (32-byte hex)
# TOKEN_ENCRYPTION_KEY: encrypts Google OAuth refresh tokens at rest using AES-256-GCM (32-byte hex)
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# Local AI Engine (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=embeddinggemma-2:270m

# LanceDB Vector Store (RAG)
LANCEDB_PATH=./data/lancedb
RAG_MAX_DISTANCE=0.5

# Automation & Safety Guardrails
# Maximum automated replies per user per UTC day
DAILY_REPLY_CAP=50
# Window in days to group follow-up emails into existing threads
GROUP_WINDOW_DAYS=14
# Network DNS resolution order: prefer IPv4 over IPv6 to avoid ECONNRESET on Google APIs
PREFER_IPV4=true
